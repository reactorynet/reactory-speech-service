# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Models (downloaded at runtime)
models/*.onnx
models/*.bin
models/*.pt
models/faster-whisper-*/
models/whisper-*/
# A symlinked model directory is a symlink to git, not a directory, so the
# trailing-slash patterns above miss it; `models/whisper-base -> ...` showed up
# as untracked. Match the name with or without a trailing slash.
models/whisper-*
models/faster-whisper-*

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env

# OS
.DS_Store
Thumbs.db

# Test / Coverage
.coverage
htmlcov/
.pytest_cache/

# Synthesis cache (in-process LRU is not persisted; the disk tier is local)
.cache/

# Evaluation reports (ad-hoc runs; committed baselines live in app/eval/baselines)
reports/
# Designed-voice preview WAVs (derived from the recipe and regenerated on demand)
data/previews/

# Chatterbox weights (optional expressive engine; downloaded on demand, never committed)
models/chatterbox/
models/**/*.safetensors

# ProcessAITicket pipeline scratch state (report, review, publish decision).
# Never committed: a tracked .ai-agent/ leaks into every later worktree and a
# stale review-normalised.json can present another ticket's approval as this
# run's verdict. See PROCESS-003 (REACTORY-302016408/20261113/2279880544).
.ai-agent/
