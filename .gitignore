# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Models (downloaded at runtime)
models/*.onnx
models/*.bin
models/*.pt
models/faster-whisper-*/
models/whisper-*/
# A symlinked model directory is a symlink to git, not a directory, so the
# trailing-slash patterns above miss it; `models/whisper-base -> ...` showed up
# as untracked. Match the name with or without a trailing slash.
models/whisper-*
models/faster-whisper-*

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env

# OS
.DS_Store
Thumbs.db

# Test / Coverage
.coverage
htmlcov/
.pytest_cache/

# Synthesis cache (in-process LRU is not persisted; the disk tier is local)
.cache/

# Evaluation reports (ad-hoc runs; committed baselines live in app/eval/baselines)
reports/
# Designed-voice preview WAVs (derived from the recipe and regenerated on demand)
data/previews/

# Chatterbox weights (optional expressive engine; downloaded on demand, never committed)
models/chatterbox/
models/**/*.safetensors

# SPEECH-006 — consent-first voice cloning (ADR-0003).
# The approver allowlist is deployed per instance and MUST NOT be committed: it
# names the people allowed to approve a clone, so a committed copy would be both
# public and stale. Absent/empty makes cloning unavailable (fail closed).
data/clone_approvers.json
# Instance signing key and reference-audio encryption key. Separate files on
# purpose: a database/backup compromise must not also expose voice clips.
data/keys/
# Consent records, encrypted embeddings, the provenance manifest registry and
# the audit log are runtime data, not source.
data/clones/
