# Reactory Speech Service Configuration

# Server
SPEECH_SERVICE_HOST=0.0.0.0
SPEECH_SERVICE_PORT=8765

# TTS (Kokoro)
KOKORO_MODEL_PATH=models/kokoro-v1_9.onnx
KOKORO_VOICES_PATH=models/voices-v1_0.bin
# Must be an enabled voice id from GET /api/tts/voices
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_DEFAULT_SPEED=1.0

# STT (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# STT — Phase 7: VAD, streaming and language confidence
WHISPER_WORD_TIMESTAMPS=false
WHISPER_VAD_ENABLED=true
WHISPER_STREAM_MIN_WINDOW_SECONDS=2.0
WHISPER_LANGUAGE_CONFIDENCE_THRESHOLD=0.6

# TTS — Phase 3: concurrency and engine lifecycle
# Inference runs on this bounded thread pool, never on the event loop.
SPEECH_THREAD_POOL_SIZE=4
# Per-engine concurrency limits as a JSON map. "default" covers unlisted engines.
SPEECH_ENGINE_MAX_CONCURRENCY='{"kokoro": 2, "default": 1}'
# Engines beyond this budget load lazily on first use; one engine is always kept
# resident so readiness and the next request never pay a cold load.
SPEECH_MAX_LOADED_ENGINES=2
SPEECH_ENGINE_IDLE_TIMEOUT_SECONDS=300
SPEECH_ENGINE_REAPER_INTERVAL_SECONDS=30
# After a failed load, do not retry that engine for this long. Keeps a broken
# optional engine (absent weights, broken torch/perth) from repeating its whole
# preflight + model construction on every request before falling back.
SPEECH_ENGINE_LOAD_RETRY_SECONDS=30

# TTS — Phase 2: designed voices (blends of Kokoro style tensors)
# The registry stores RECIPES, never tensors. A missing or malformed file is
# tolerated: the service continues with the shipped pack voices only.
DESIGNED_VOICES_PATH=data/designed_voices.json
DESIGNED_VOICES_PREVIEW_DIR=data/previews
# One resolved tensor is ~522 KB; this bounds the in-memory cache.
DESIGNED_VOICE_TENSOR_CACHE_SIZE=64

# TTS — Phase 3: synthesis cache (in-process LRU + local disk, no Redis)
SPEECH_CACHE_ENABLED=true
SPEECH_CACHE_DIR=.cache/tts
SPEECH_CACHE_TTL_SECONDS=86400
SPEECH_CACHE_LRU_ENTRIES=256
SPEECH_CACHE_LRU_MAX_BYTES=16777216
SPEECH_CACHE_LRU_MAX_ENTRY_BYTES=524288
SPEECH_CACHE_DISK_MAX_BYTES=536870912

# Model download
MODELS_DIR=models

# Phonetic processing
PHONETIC_PROCESSING_ENABLED=true

# TTS — Phase 4: optional expressive engine (Chatterbox, MIT; CPU-only).
# OFF by default. With it off the adapter is never imported and the service
# needs neither torch nor the 3.1 GB weights. Enable only in the
# speech-expressive profile, with the model volume mounted.
CHATTERBOX_ENABLED=false
CHATTERBOX_VARIANT=standard
CHATTERBOX_DEVICE=cpu
CHATTERBOX_MODEL_DIR=models/chatterbox

# TTS — Phase 5: consent-first voice cloning (SPEECH-006 / ADR-0003).
# Cloning is UNAVAILABLE unless all three files exist. These are per-deployment
# secrets and MUST NOT be committed (they are in .gitignore). Generate them with
#   python scripts/generate_clone_keys.py --output-dir data
# then add approver emails to data/clone_approvers.json. An empty allowlist means
# cloning is unavailable, never unrestricted.
CLONE_APPROVERS_PATH=data/clone_approvers.json
CLONE_SIGNING_KEY_PATH=data/keys/clone_signing_key.pem
CLONE_REFERENCE_KEY_PATH=data/keys/clone_reference.key
CLONE_STORE_DIR=data/clones
# Stable instance identity recorded inside every signature
# (empty -> key-<signing key fingerprint>; hostnames change on redeploy).
CLONE_INSTANCE_ID=
# Header the authorising gateway sets to the authenticated caller. When set,
# the consent approver must equal it. Empty: keep the clone endpoints internal.
CLONE_PRINCIPAL_HEADER=
